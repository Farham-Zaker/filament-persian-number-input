{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "farham-zaker/filament-persian-number-input",
    "description": "A Persian/Farsi number input field for Filament with RTL digit formatting, thousand separators, and stepper controls",
    "type": "library",
    "keywords": [
        "filament",
        "laravel",
        "persian",
        "farsi",
        "number",
        "input",
        "forms"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Farham Zaker"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "FarhamZaker\\FilamentPersianNumberInput\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FarhamZaker\\FilamentPersianNumberInput\\PersianNumberInputServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
